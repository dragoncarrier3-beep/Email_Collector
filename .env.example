# Copy this file to ".env" and fill in the values.
# Register an OAuth app at: https://github.com/settings/developers
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/auth/github/callback

GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# Must exactly match the callback URL you set on GitHub.
OAUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback

# A long random string used to sign the state cookie (any random text).
SESSION_SECRET=change_me_to_a_long_random_string

# Protects the /admin export endpoint. Pick a strong secret.
ADMIN_TOKEN=change_me_admin_token

PORT=3000

# ── Gmail drip campaign ──────────────────────────────────────────────────────
# Primary sender Gmail address + App Password
# Create App Password: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_USER=dragonalche9421@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Optional second sender (rotates between the two)
GMAIL_USER2=dragoncarrier3@gmail.com
GMAIL_APP_PASS2=xxxx xxxx xxxx xxxx
