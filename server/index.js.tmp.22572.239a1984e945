require('dotenv').config();
const nodemailer = require('nodemailer');
const https = require('https');
const http  = require('http');
const fs   = require('fs');
const path = require('path');
const initSqlJs = require('sql.js');

// ── Config ─────────────────────────────────────────────────────────────────
const GH_TOKEN         = process.env.GH_TOKEN         || '';
const GMAIL_USER       = process.env.GMAIL_USER        || '';
const GMAIL_APP_PASS   = process.env.GMAIL_APP_PASSWORD || '';
const SEND_INTERVAL_MS = 6 * 60 * 1000; // 1 email / 6 min = 10/hr = 240/day
let nextSendAt = null;
const GH_DELAY_MS      = 250;            // ~4 users/sec — stays under rate limit
const BLOCKED_REGIONS  = ['india','pakistan','africa','bangladesh','nepal','indonesia'];

const CAMPAIGN_SUBJECT = 'Working together';
const CAMPAIGN_BODY =
`I came across your profile and wanted to reach out directly.

I'm a developer focused on freelance work and I've been looking for people open to collaborating on software projects — web development, automation, and API integrations mainly.

If that's something you'd consider, I'd be happy to share more details. No pitch, just genuinely curious whether there's a fit.`;

// ── Storage ────────────────────────────────────────────────────────────────
const DATA_DIR = path.join(__dirname, 'data');
const DB_FILE  = path.join(DATA_DIR, 'realman.db');
if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });

let db; // sql.js Database instance — initialised in main()

function dbSave() {
  fs.writeFileSync(DB_FILE, Buffer.from(db.export()));
}

function dbInit(SQL) {
  const existing = fs.existsSync(DB_FILE) ? fs.readFileSync(DB_FILE) : null;
  db = existing ? new SQL.Database(existing) : new SQL.Database();

  db.run(`CREATE TABLE IF NOT EXISTS emails (
    email     TEXT PRIMARY KEY,
    login     TEXT, name TEXT, location TEXT, country TEXT,
    company   TEXT, bio TEXT, blog TEXT, twitter TEXT,
    followers INTEGER DEFAULT 0, repos INTEGER DEFAULT 0,
    hireable  INTEGER DEFAULT 0, avatar TEXT, profile TEXT,
    seen_at   TEXT
  )`);
  db.run(`CREATE TABLE IF NOT EXISTS sent (
    email TEXT PRIMARY KEY,
    sent_at TEXT
  )`);
  db.run(`CREATE TABLE IF NOT EXISTS state (
    key TEXT PRIMARY KEY,
    value TEXT
  )`);
  dbSave();
}

// State helpers (lastId, dailyCount, dailyDate)
function getState(key, def) {
  const r = db.exec(`SELECT value FROM state WHERE key='${key}'`);
  return (r.length && r[0].values.length) ? r[0].values[0][0] : def;
}
function setState(key, value) {
  db.run(`INSERT OR REPLACE INTO state(key,value) VALUES(?,?)`, [key, String(value)]);
}

// Convenience wrappers
function dbAllEmails() {
  const r = db.exec('SELECT * FROM emails ORDER BY seen_at DESC');
  if (!r.length) return [];
  const cols = r[0].columns;
  return r[0].values.map(row => {
    const obj = {};
    cols.forEach((c, i) => obj[c] = row[i]);
    obj.hireable = !!obj.hireable;
    return obj;
  });
}
function dbEmailExists(email) {
  const r = db.exec(`SELECT 1 FROM emails WHERE email=? LIMIT 1`, [email.toLowerCase()]);
  return r.length && r[0].values.length > 0;
}
function dbLoginExists(login) {
  const r = db.exec(`SELECT 1 FROM emails WHERE login=? LIMIT 1`, [login.toLowerCase()]);
  return r.length && r[0].values.length > 0;
}
function dbInsertEmail(e) {
  db.run(`INSERT OR IGNORE INTO emails
    (email,login,name,location,country,company,bio,blog,twitter,followers,repos,hireable,avatar,profile,seen_at)
    VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`,
    [e.email.toLowerCase(), e.login, e.name, e.location, e.country,
     e.company, e.bio, e.blog, e.twitter,
     e.followers, e.repos, e.hireable ? 1 : 0,
     e.avatar, e.profile, e.seen_at]);
  dbSave();
}
function dbIsSent(email) {
  const r = db.exec(`SELECT 1 FROM sent WHERE email=? LIMIT 1`, [email.toLowerCase()]);
  return r.length && r[0].values.length > 0;
}
function dbMarkSent(email) {
  db.run(`INSERT OR IGNORE INTO sent(email,sent_at) VALUES(?,?)`,
    [email.toLowerCase(), new Date().toISOString()]);
  dbSave();
}
function dbSentCount() {
  const r = db.exec('SELECT COUNT(*) FROM sent');
  return r.length ? r[0].values[0][0] : 0;
}
function dbSentToday() {
  const today = new Date().toISOString().slice(0,10);
  const r = db.exec(`SELECT COUNT(*) FROM sent WHERE sent_at LIKE '${today}%'`);
  return r.length ? r[0].values[0][0] : 0;
}

// Compatibility shim — keep `emails` and `state` as thin proxies for dashboard code
let emails = [];
let state  = { sent: [], dailyCount: 0, dailyDate: '', lastId: 0 };
function syncState() {
  state.lastId    = parseInt(getState('lastId', '0')) || 0;
  state.dailyCount = dbSentToday();
  state.dailyDate  = new Date().toDateString();
  state.sent       = []; // no longer used — DB handles it
  emails           = dbAllEmails();
}
function saveState(s) {
  if (s.lastId !== undefined) setState('lastId', s.lastId);
}

// ── Gmail transport ────────────────────────────────────────────────────────
const transporter = nodemailer.createTransport({
  host: 'smtp.gmail.com',
  port: 587,
  secure: false, // STARTTLS
  auth: { user: GMAIL_USER, pass: GMAIL_APP_PASS }
});

// ── GitHub API ─────────────────────────────────────────────────────────────
function ghGet(apiPath) {
  return new Promise((resolve, reject) => {
    const opts = {
      hostname: 'api.github.com',
      path: apiPath,
      headers: {
        Authorization: `Bearer ${GH_TOKEN}`,
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28',
        'User-Agent': 'Realman/1.0'
      }
    };
    https.get(opts, res => {
      let body = '';
      res.on('data', d => body += d);
      res.on('end', () => {
        if (res.statusCode === 200) {
          try { resolve(JSON.parse(body)); } catch(e) { reject(e); }
        } else {
          reject(new Error(`GitHub ${res.statusCode}: ${body.slice(0,120)}`));
        }
      });
    }).on('error', reject);
  });
}

const sleep = ms => new Promise(r => setTimeout(r, ms));

// Best-effort country extraction from GitHub's free-form location string
const COUNTRY_MAP = {
  'usa':'USA','united states':'USA','us':'USA','america':'USA',
  'uk':'UK','united kingdom':'UK','england':'UK','britain':'UK',
  'canada':'Canada','germany':'Germany','deutschland':'Germany',
  'france':'France','australia':'Australia','india':'India',
  'netherlands':'Netherlands','brazil':'Brazil','spain':'Spain',
  'italy':'Italy','russia':'Russia','china':'China','japan':'Japan',
  'sweden':'Sweden','norway':'Norway','denmark':'Denmark',
  'finland':'Finland','switzerland':'Switzerland','austria':'Austria',
  'poland':'Poland','turkey':'Turkey','portugal':'Portugal',
  'south korea':'South Korea','korea':'South Korea',
  'new zealand':'New Zealand','singapore':'Singapore',
  'israel':'Israel','ukraine':'Ukraine','czech':'Czech Republic',
  'argentina':'Argentina','mexico':'Mexico','colombia':'Colombia',
  'pakistan':'Pakistan','bangladesh':'Bangladesh','nigeria':'Nigeria',
  'indonesia':'Indonesia','malaysia':'Malaysia','thailand':'Thailand',
};
function extractCountry(location) {
  if (!location) return '';
  const l = location.toLowerCase();
  for (const [key, val] of Object.entries(COUNTRY_MAP)) {
    // Match as whole word to avoid 'us' inside 'Austria', 'russia', etc.
    const re = new RegExp(`(?:^|[\\s,])${key.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}(?:[\\s,]|$)`);
    if (re.test(l)) return val;
  }
  return '';
}

// ── Collector: scans ALL GitHub users continuously ─────────────────────────
let collecting = false;

async function collectLoop() {
  if (collecting) return;
  collecting = true;
  syncState();
  log('Collector started (US-only). Resuming from user ID', state.lastId);

  while (true) {
    if (!collecting) break;
    let users;
    try {
      users = await ghGet(`/users?per_page=100&since=${state.lastId}`);
    } catch(e) {
      const msg = e.message || '';
      const wait = msg.includes('403') || msg.includes('429') ? 60000 : 5000;
      log(`GitHub error — waiting ${wait/1000}s:`, msg);
      await sleep(wait);
      continue;
    }

    if (!Array.isArray(users) || !users.length) {
      log('Reached end of GitHub users — restarting scan from ID 0');
      state.lastId = 0;
      saveState(state);
      continue;
    }

    for (const u of users) {
      if (!collecting) break;
      state.lastId = u.id;
      setState('lastId', u.id);

      if (dbLoginExists(u.login || '')) {
        await sleep(30);
        continue;
      }

      try {
        const profile = await ghGet(`/users/${u.login}`);

        // ── US-only filter ──
        const country = extractCountry(profile.location || '');
        if (country !== 'USA') {
          if (profile.login) {
            // mark login seen so we skip on next scan
            db.run(`INSERT OR IGNORE INTO emails(email,login,country,seen_at) VALUES(?,?,?,?)`,
              ['_no_email_' + profile.login, profile.login, country, new Date().toISOString()]);
          }
          await sleep(GH_DELAY_MS);
          continue;
        }

        if (profile.email) {
          if (!dbEmailExists(profile.email)) {
            const entry = {
              login:    profile.login              || '',
              name:     profile.name               || '',
              email:    profile.email,
              location: profile.location           || '',
              country:  country,
              company:  (profile.company||'').replace(/^@/,''),
              bio:      profile.bio                || '',
              blog:     profile.blog               || '',
              twitter:  profile.twitter_username   || '',
              followers:profile.followers          || 0,
              repos:    profile.public_repos       || 0,
              hireable: profile.hireable           || false,
              avatar:   profile.avatar_url         || '',
              profile:  'https://github.com/' + profile.login,
              seen_at:  new Date().toISOString()
            };
            dbInsertEmail(entry);
            syncState();
            log(`+ ${profile.email} (${profile.login}) [US] — total: ${emails.length}`);
          }
        }
      } catch(e) {
        if ((e.message||'').includes('403') || (e.message||'').includes('429')) {
          log('Rate limited — waiting 60s');
          await sleep(60000);
        }
      }

      await sleep(GH_DELAY_MS);
    }
  }
  collecting = false;
}

// ── Campaign: sends 1 email every 6 minutes ────────────────────────────────
async function campaignTick() {
  // Get next unsent US email from DB
  const r2 = db.exec(
    `SELECT * FROM emails
     WHERE email NOT LIKE '_no_email_%'
       AND email NOT IN (SELECT email FROM sent)
     ORDER BY seen_at ASC LIMIT 1`
  );
  if (!r2.length || !r2[0].values.length) {
    log('No unsent emails — waiting for collector to find more…');
    return;
  }
  const cols = r2[0].columns;
  const row  = r2[0].values[0];
  const r    = {};
  cols.forEach((c, i) => r[c] = row[i]);

  const today    = dbSentToday();
  const total    = dbSentCount();
  const greeting = r.name ? 'Hi ' + r.name.split(' ')[0] + ',\n\n' : '';
  const body     = greeting + CAMPAIGN_BODY;

  try {
    await transporter.sendMail({
      from:    '"Realman" <' + GMAIL_USER + '>',
      to:      r.email,
      subject: CAMPAIGN_SUBJECT,
      text:    body
    });
    dbMarkSent(r.email);
    log('✓ Sent to ' + r.email + ' (' + (r.name || r.login) + ') — today: ' + (today+1) + ', total: ' + (total+1));
  } catch(e) {
    const isNetworkBlock = e.message.includes('ETIMEDOUT') || e.message.includes('ECONNREFUSED');
    if (isNetworkBlock) {
      log('✗ SMTP blocked (' + e.message + ') — will retry next tick');
    } else {
      dbMarkSent(r.email); // bad address — skip permanently
      log('✗ Failed ' + r.email + ': ' + e.message);
    }
  }
}

// ── Logger ─────────────────────────────────────────────────────────────────
const logBuffer = [];
function log(...args) {
  const ts  = new Date().toISOString().replace('T',' ').slice(0,19);
  const line = `[${ts}] ${args.join(' ')}`;
  console.log(line);
  logBuffer.unshift(line);
  if (logBuffer.length > 200) logBuffer.pop();
}

// ── Dashboard (http://localhost:3000) ──────────────────────────────────────
function realEmails() {
  return emails.filter(e => !e.email.startsWith('_no_email_'));
}

function dashboardHTML() {
  syncState();
  const real = realEmails();
  const totalSent = dbSentCount();
  const daily     = dbSentToday();
  const r = db.exec(
    `SELECT COUNT(*) FROM emails WHERE email NOT LIKE '_no_email_%' AND email NOT IN (SELECT email FROM sent)`
  );
  const unsent   = r.length ? r[0].values[0][0] : 0;
  const nextSend  = nextSendAt ? new Date(nextSendAt).toLocaleTimeString() : '—';
  const logLines  = logBuffer.slice(0, 80);
  const nowStr    = new Date().toLocaleString();

  const logHTML = logLines.map(l => {
    const cls = l.includes('✓') ? 'ok' : l.includes('✗') || l.includes('⚠') ? 'err' : '';
    return `<div class="log-line ${cls}">${l.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</div>`;
  }).join('');

  return `<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="refresh" content="10">
<title>Realman</title>
<script>
  // Apply saved theme BEFORE paint — no flash
  (function(){ document.documentElement.setAttribute('data-theme', localStorage.getItem('rm-theme')||'light'); })();
</script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
  *{box-sizing:border-box;margin:0;padding:0}

  /* ══ WHITE is the default ══ */
  body{font-family:'Inter',sans-serif;background:#fff;color:#111;font-size:14px;line-height:1.55;min-height:100vh}
  header{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border-bottom:1.5px solid #e8e8e8;padding:0 32px;height:60px;display:flex;align-items:center;justify-content:space-between}
  .logo-icon{width:34px;height:34px;border-radius:9px;background:#111;display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:900;color:#fff}
  .logo{display:flex;align-items:center;gap:10px}
  .logo-name{font-size:1rem;font-weight:800;color:#111}
  .logo-sub{font-size:.7rem;color:#888}
  .badge{display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:99px;font-size:.75rem;font-weight:600;border:1px solid #e0e0e0;color:#888}
  .badge.on{border-color:#22c55e;color:#16a34a}
  .badges{display:flex;gap:8px}
  .pulse{width:6px;height:6px;border-radius:50%;background:currentColor;animation:pulse 1.8s ease-in-out infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
  main{max-width:1300px;margin:0 auto;padding:32px 32px 60px}
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px;margin-bottom:32px}
  .stat{background:#fff;border:1.5px solid #e8e8e8;border-radius:14px;padding:20px 18px}
  .stat.gold{border-color:#f5a623;background:#fffbf0}
  .stat-val{font-size:2.4rem;font-weight:900;line-height:1;margin-bottom:4px;letter-spacing:-.03em;color:#111}
  .stat.gold .stat-val{color:#d97706}
  .stat-lbl{font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#999}
  .ctrl-btn{padding:10px 24px;border-radius:9px;border:none;font-size:.88rem;font-weight:700;cursor:pointer;transition:opacity .15s}
  .ctrl-btn:hover{opacity:.82}
  .ctrl-btn:disabled{opacity:.35;cursor:default}
  .ctrl-btn.green{background:#22c55e;color:#fff}
  .ctrl-btn.blue{background:#3b82f6;color:#fff}
  .ctrl-btn.red{background:#ef4444;color:#fff}
  .panel{background:#fff;border:1.5px solid #e8e8e8;border-radius:14px;padding:20px}
  .sec-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
  .sec-title{font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#999}
  table{width:100%;border-collapse:collapse;font-size:.78rem}
  table{width:100%;table-layout:fixed;border-collapse:collapse}
  th{padding:7px 8px;text-align:left;font-size:.65rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:#aaa;white-space:nowrap;border-bottom:1.5px solid #e8e8e8}
  td{padding:7px 8px;border-bottom:1px solid #f0f0f0;color:#222;vertical-align:middle;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  tr:last-child td{border:none}
  tr:hover td{background:#fafafa}
  #filter-row td{padding:3px 5px;background:#f8f8f8;border-bottom:1.5px solid #e8e8e8}
  .av{width:28px;height:28px;border-radius:50%;object-fit:cover;vertical-align:middle;margin-right:6px;background:#eee}
  .av-ph{width:28px;height:28px;border-radius:50%;background:#e0e0e0;display:inline-flex;align-items:center;justify-content:center;font-size:.65rem;color:#888;vertical-align:middle;margin-right:6px}
  .col-filter-styled{width:100%;background:#fff;border:1px solid #ddd;color:#111;border-radius:5px;padding:3px 7px;font-size:.72rem;outline:none}
  .log-wrap{background:#fff;border:1.5px solid #e8e8e8;border-radius:14px;overflow:hidden}
  .log-scroll{max-height:360px;overflow-y:auto;padding:16px 20px}
  .log-line{font-family:'Courier New',monospace;font-size:.76rem;line-height:1.9;white-space:pre-wrap;word-break:break-all;color:#666;border-bottom:1px solid #f5f5f5;padding-bottom:1px}
  .log-line:last-child{border:none}
  .log-line.ok{color:#16a34a}
  .log-line.err{color:#dc2626}
  .btn-action{background:#111;color:#fff;border:none;border-radius:7px;padding:6px 16px;font-size:.78rem;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block}
  .btn-action:hover{opacity:.85}
  .btn-upload{background:#fff;border:1.5px solid #ddd;color:#111;border-radius:7px;padding:6px 16px;font-size:.78rem;font-weight:600;cursor:pointer}
  code{background:#f0f0f0;padding:1px 5px;border-radius:4px;font-size:.76rem}
  footer{text-align:center;padding:28px 0;font-size:.75rem;color:#bbb}
  footer a{color:#111;font-weight:600;text-decoration:none}

  /* ══ DARK mode overrides ══ */
  [data-theme="dark"] body{background:#0d0d0d;color:#f0f0f0}
  [data-theme="dark"] header{background:rgba(13,13,13,.94);border-color:#2a2a2a}
  [data-theme="dark"] .logo-icon{background:#f5a623;color:#000}
  [data-theme="dark"] .logo-name{color:#f0f0f0}
  [data-theme="dark"] .logo-sub{color:#666}
  [data-theme="dark"] .badge{border-color:#333;color:#666}
  [data-theme="dark"] .badge.on{border-color:#22c55e;color:#22c55e}
  [data-theme="dark"] .stat{background:#181818;border-color:#2a2a2a}
  [data-theme="dark"] .stat.gold{background:rgba(245,166,35,.07);border-color:rgba(245,166,35,.4)}
  [data-theme="dark"] .stat-val{color:#f0f0f0}
  [data-theme="dark"] .stat.gold .stat-val{color:#f5a623}
  [data-theme="dark"] .stat-lbl{color:#555}
  [data-theme="dark"] .panel{background:#181818;border-color:#2a2a2a}
  [data-theme="dark"] .sec-title{color:#555}
  [data-theme="dark"] th{color:#555;border-color:#2a2a2a}
  [data-theme="dark"] td{color:#ccc;border-color:#1e1e1e}
  [data-theme="dark"] tr:hover td{background:#1a1a1a}
  [data-theme="dark"] #filter-row td{background:#111;border-color:#2a2a2a}
  [data-theme="dark"] .col-filter-styled{background:#1e1e1e;border-color:#333;color:#eee}
  [data-theme="dark"] .log-wrap{background:#181818;border-color:#2a2a2a}
  [data-theme="dark"] .log-line{color:#666;border-color:#1e1e1e}
  [data-theme="dark"] .log-line.ok{color:#22c55e}
  [data-theme="dark"] .log-line.err{color:#ef4444}
  [data-theme="dark"] .btn-action{background:#f0f0f0;color:#000}
  [data-theme="dark"] .btn-upload{background:#1e1e1e;border-color:#333;color:#eee}
  [data-theme="dark"] code{background:#222;color:#ccc}
  [data-theme="dark"] footer{color:#444}
  [data-theme="dark"] footer a{color:#ccc}
  [data-theme="dark"] #theme-toggle{background:#1e1e1e;border-color:#333;color:#eee}
</style>
</head>
<body>
<header>
  <div class="logo">
    <div class="logo-icon">R</div>
    <div>
      <div class="logo-name">Realman</div>
      <div class="logo-sub">Email Collector &amp; Campaign</div>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:12px">
    <!-- Theme toggle -->
    <button id="theme-toggle" style="
      background:#fff;border:1.5px solid #ddd;color:#111;
      border-radius:99px;padding:6px 16px;font-size:.8rem;font-weight:600;
      cursor:pointer;display:flex;align-items:center;gap:7px;transition:border-color .15s
    ">
      <span id="theme-icon">🌙</span><span id="theme-label">Dark</span>
    </button>
    <div class="badges">
      <span class="badge ${collecting?'on':'off'}">
        <span class="pulse"></span>${collecting?'Collecting':'Idle'}
      </span>
      <span class="badge ${campaignRunning?'on':'off'}">
        <span class="pulse"></span>${campaignRunning?'Campaign On':'Campaign Off'}
      </span>
    </div>
  </div>
</header>

<main>
  <div class="stats">
    <div class="stat gold">
      <div class="stat-val">${real.length.toLocaleString()}</div>
      <div class="stat-lbl">Collected</div>
    </div>
    <div class="stat">
      <div class="stat-val">${totalSent.toLocaleString()}</div>
      <div class="stat-lbl">All-time Sent</div>
    </div>
    <div class="stat">
      <div class="stat-val">${daily}</div>
      <div class="stat-lbl">Sent Today</div>
    </div>
    <div class="stat">
      <div class="stat-val">${unsent.toLocaleString()}</div>
      <div class="stat-lbl">Unsent</div>
    </div>
    <div class="stat">
      <div class="stat-val">10<span style="font-size:1.2rem;font-weight:600;color:#999">/hr</span></div>
      <div class="stat-lbl">Send Rate</div>
    </div>
    <div class="stat">
      <div class="stat-val" style="font-size:1.5rem">${nextSend}</div>
      <div class="stat-lbl">Next Send</div>
    </div>
  </div>

  <!-- Control buttons -->
  <div style="display:flex;gap:14px;margin-bottom:16px;flex-wrap:wrap;align-items:center">
    <button id="btn-collect" class="ctrl-btn green" onclick="ctrlAction('collect-start')">
      ▶ Get Emails
    </button>
    <button id="btn-send" class="ctrl-btn blue" onclick="ctrlAction('campaign-start')">
      ✉ Send Emails
    </button>
    <button id="btn-stop" class="ctrl-btn red" onclick="ctrlAction('stop-all')">
      ■ Stop All
    </button>
  </div>
  <!-- Status row -->
  <div style="display:flex;gap:20px;margin-bottom:32px;flex-wrap:wrap;align-items:center">
    <div id="status-collect" style="display:flex;align-items:center;gap:8px;font-size:.84rem;font-weight:600;color:#999">
      <span id="dot-collect" style="width:9px;height:9px;border-radius:50%;background:#ddd;display:inline-block"></span>
      <span id="label-collect">Collector: Idle</span>
    </div>
    <div id="status-send" style="display:flex;align-items:center;gap:8px;font-size:.84rem;font-weight:600;color:#999">
      <span id="dot-send" style="width:9px;height:9px;border-radius:50%;background:#ddd;display:inline-block"></span>
      <span id="label-send">Campaign: Off</span>
    </div>
    <span id="ctrl-msg" style="font-size:.84rem;color:#999"></span>
  </div>

  <!-- CSV Import -->
  <div class="sec-hdr" style="margin-bottom:14px">
    <span class="sec-title">Import CSV</span>
  </div>
  <div class="panel" style="margin-bottom:40px">
    <p style="color:#888;font-size:.85rem;margin-bottom:14px">
      Upload a CSV file with an <code>email</code> column (and optionally <code>name</code>, <code>login</code>, <code>location</code>).
      Duplicates are skipped automatically.
    </p>
    <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
      <label class="btn-upload" for="csv-file">Choose CSV file</label>
      <input type="file" id="csv-file" accept=".csv,text/csv" style="display:none">
      <span id="csv-name" style="color:#888;font-size:.85rem">No file chosen</span>
      <button class="btn-action" id="csv-import-btn" disabled>Import</button>
      <span id="csv-msg" style="font-size:.85rem"></span>
    </div>
  </div>

  <!-- Email list -->
  <div class="sec-hdr">
    <span class="sec-title">Collected Emails <span id="visible-count" style="color:#999;font-weight:400">(${real.length.toLocaleString()})</span></span>
    <a href="/export.csv" class="btn-action" style="text-decoration:none;font-size:.8rem;padding:6px 16px">⬇ Export CSV</a>
  </div>
  <div class="panel" style="padding:0;overflow:hidden;margin-bottom:40px">
    <div style="overflow-x:auto">
      <table id="email-table">
        <thead>
          <tr>
            <th style="width:40px">#</th>
            <th>Email</th>
            <th>Name</th>
            <th>Login</th>
            <th>Country</th>
            <th>Location</th>
            <th>Company</th>
            <th>Followers</th>
            <th>Repos</th>
            <th>Hireable</th>
            <th>Sent</th>
            <th>Date</th>
          </tr>
          <tr id="filter-row">
            <td></td>
            <td><input class="col-filter" data-col="1" placeholder="email…"></td>
            <td><input class="col-filter" data-col="2" placeholder="name…"></td>
            <td><input class="col-filter" data-col="3" placeholder="login…"></td>
            <td><input class="col-filter" data-col="4" placeholder="country…"></td>
            <td><input class="col-filter" data-col="5" placeholder="location…"></td>
            <td><input class="col-filter" data-col="6" placeholder="company…"></td>
            <td><input class="col-filter" data-col="7" placeholder="min…" style="width:60px"></td>
            <td></td>
            <td>
              <select class="col-filter" data-col="9" style="width:80px">
                <option value="">all</option>
                <option value="yes">yes</option>
                <option value="no">no</option>
              </select>
            </td>
            <td>
              <select class="col-filter" data-col="10" style="width:80px">
                <option value="">all</option>
                <option value="✓">sent</option>
                <option value="–">unsent</option>
              </select>
            </td>
            <td></td>
          </tr>
        </thead>
        <tbody id="email-tbody">
          ${(()=>{
            return real.slice(0,500).map((e,i)=>{
              const sent = dbIsSent(e.email);
              const _enc = encodeURIComponent(JSON.stringify([
                String(i+1), e.email||'', e.name||'', e.login||'',
                e.country||'', e.location||'', e.company||'',
                String(e.followers||0), String(e.repos||0),
                e.hireable?'yes':'no', sent?'check':'dash',
                (e.seen_at||'').slice(0,10)
              ]));
              const _login = e.login ? '<a href="'+(e.profile||'')+'" target="_blank" style="color:#888">@'+e.login+'</a>' : '&mdash;';
              const _hire  = e.hireable ? '<span style="color:#16a34a">yes</span>' : '&mdash;';
              return '<tr data-cols="'+_enc+'">'
                + '<td style="color:#bbb">'+(i+1)+'</td>'
                + '<td><a href="mailto:'+(e.email||'')+'" style="color:#d97706">'+(e.email||'')+'</a></td>'
                + '<td>'+(e.name||'&mdash;')+'</td>'
                + '<td>'+_login+'</td>'
                + '<td>'+(e.country||'&mdash;')+'</td>'
                + '<td style="max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="'+(e.location||'')+'">'+(e.location||'&mdash;')+'</td>'
                + '<td>'+(e.company||'&mdash;')+'</td>'
                + '<td>'+(e.followers||0).toLocaleString()+'</td>'
                + '<td>'+(e.repos||0)+'</td>'
                + '<td>'+_hire+'</td>'
                + '<td style="color:'+(sent?'#16a34a':'#bbb')+'">'+(sent?'&#10003;':'&ndash;')+'</td>'
                + '<td style="color:#aaa;font-size:.78rem">'+(e.seen_at||'').slice(0,10)+'</td>'
                + '</tr>';
            }).join('');
          })()}
        </tbody>
      </table>
      ${real.length>500?'<div style="padding:14px 20px;color:#999;font-size:.82rem">Showing first 500 of '+real.length.toLocaleString()+' — export CSV for full list</div>':''}
    </div>
  </div>

  <!-- Live Log -->
  <div class="sec-hdr">
    <span class="sec-title">Live Log</span>
    <span class="sec-time" style="color:#aaa;font-size:.75rem">Updated ${nowStr} · auto-refreshes every 10s · <a href="/" style="color:#888">refresh</a></span>
  </div>
  <div class="log-wrap">
    <div class="log-scroll">
      ${logHTML || '<div class="log-line" style="color:#bbb">Waiting for activity…</div>'}
    </div>
  </div>
</main>

<footer>
  Realman &nbsp;·&nbsp; <a href="/">Refresh</a>
</footer>
<script>
// ── Control buttons ───────────────────────────────────────────────────────
function setStatusDot(id, active, label) {
  const dot = document.getElementById('dot-' + id);
  const lbl = document.getElementById('label-' + id);
  if (!dot || !lbl) return;
  if (active) {
    dot.style.background = id === 'collect' ? '#22c55e' : '#3b82f6';
    dot.style.animation  = 'pulse 1.4s ease-in-out infinite';
    lbl.style.color = '#111';
  } else {
    dot.style.background = '#ddd';
    dot.style.animation  = 'none';
    lbl.style.color = '#999';
  }
  lbl.textContent = label;
}

async function pollStatus() {
  try {
    const r = await fetch('/api/stats');
    const d = await r.json();
    setStatusDot('collect', d.collecting,
      d.collecting ? '⟳ Collecting…' : 'Collector: Idle');
    setStatusDot('send', d.campaignRunning,
      d.campaignRunning ? '⟳ Campaign Running' : 'Campaign: Off');
    const btnC = document.getElementById('btn-collect');
    const btnS = document.getElementById('btn-send');
    if (btnC) btnC.textContent = d.collecting  ? '⟳ Collecting…' : '▶ Get Emails';
    if (btnS) btnS.textContent = d.campaignRunning ? '⟳ Sending…'  : '✉ Send Emails';
  } catch(e) {}
}
setInterval(pollStatus, 3000);
pollStatus();

async function ctrlAction(action) {
  const msg = document.getElementById('ctrl-msg');
  document.querySelectorAll('.ctrl-btn').forEach(b => b.disabled = true);
  msg.style.color = '#999';
  msg.textContent = '…';
  try {
    const res  = await fetch('/ctrl/' + action, { method: 'POST' });
    const data = await res.json();
    msg.style.color = data.ok ? '#16a34a' : '#dc2626';
    msg.textContent = data.msg || (data.ok ? 'Done.' : 'Error');
    pollStatus();
  } catch(e) {
    msg.style.color = '#dc2626';
    msg.textContent = 'Request failed: ' + e.message;
  }
  document.querySelectorAll('.ctrl-btn').forEach(b => b.disabled = false);
}

// ── Theme toggle ──────────────────────────────────────────────────────────
(function(){
  function applyTheme(t) {
    document.documentElement.setAttribute('data-theme', t);
    localStorage.setItem('rm-theme', t);
    document.getElementById('theme-icon').textContent  = t==='dark' ? '☀️' : '🌙';
    document.getElementById('theme-label').textContent = t==='dark' ? 'Light' : 'Dark';
    const btn = document.getElementById('theme-toggle');
    if (btn) { btn.style.background = t==='dark'?'#1e1e1e':'#fff'; btn.style.borderColor = t==='dark'?'#333':'#ddd'; btn.style.color = t==='dark'?'#eee':'#111'; }
  }
  const current = localStorage.getItem('rm-theme') || 'light';
  applyTheme(current);
  document.getElementById('theme-toggle').addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    applyTheme(next);
  });
})();

// ── Per-column filters ────────────────────────────────────────────────────
const filters = {};
document.querySelectorAll('.col-filter').forEach(input => {
  input.addEventListener('input', applyFilters);
  input.className += ' col-filter-styled';
  input.style.cssText = 'width:100%;border-radius:6px;padding:4px 8px;font-size:.75rem;outline:none';
});

function applyFilters() {
  document.querySelectorAll('.col-filter').forEach(el => {
    filters[el.dataset.col] = el.value.toLowerCase().trim();
  });
  let visible = 0;
  document.querySelectorAll('#email-tbody tr').forEach(row => {
    const cols = JSON.parse(decodeURIComponent(row.dataset.cols || '%5B%5D'));
    const show = Object.entries(filters).every(([ci, val]) => {
      if (!val) return true;
      const cell = (cols[+ci] || '').toLowerCase();
      // Numeric min filter for followers col (7)
      if (ci === '7' && /^\d+$/.test(val)) return parseInt(cell) >= parseInt(val);
      return cell.includes(val);
    });
    row.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  const total = ${real.length};
  document.getElementById('visible-count').textContent =
    '(' + visible.toLocaleString() + (visible < total ? ' of ' + total.toLocaleString() : '') + ')';
}

// ── CSV import ─────────────────────────────────────────────────────────────
const fileInput = document.getElementById('csv-file');
const csvName   = document.getElementById('csv-name');
const importBtn = document.getElementById('csv-import-btn');
const csvMsg    = document.getElementById('csv-msg');

fileInput.addEventListener('change', () => {
  const f = fileInput.files[0];
  csvName.textContent = f ? f.name : 'No file chosen';
  importBtn.disabled  = !f;
});

importBtn.addEventListener('click', async () => {
  const f = fileInput.files[0];
  if (!f) return;
  importBtn.disabled = true;
  csvMsg.style.color = '#aaa';
  csvMsg.textContent = 'Parsing…';

  const text  = await f.text();
  const lines = text.split(String.fromCharCode(10)).map(s => s.trim()).filter(Boolean);
  if (!lines.length) { csvMsg.textContent = 'Empty file'; importBtn.disabled=false; return; }

  const header   = lines[0].split(',').map(h => h.trim().toLowerCase().replace(/"/g,''));
  const emailCol = header.findIndex(h => h.includes('email'));
  const nameCol  = header.findIndex(h => h.includes('name'));
  const loginCol = header.findIndex(h => h.includes('login') || h.includes('username'));
  const locCol   = header.findIndex(h => h.includes('location') || h.includes('country'));

  if (emailCol === -1) {
    csvMsg.style.color='#ef4444';
    csvMsg.textContent='No "email" column found in CSV header';
    importBtn.disabled=false; return;
  }

  function cell(cells, idx) {
    return idx===-1||!cells[idx] ? '' : cells[idx].trim().replace(/^"|"$/g,'');
  }

  const entries = [];
  for (let i = 1; i < lines.length; i++) {
    const c = lines[i].split(',');
    const email = cell(c, emailCol);
    if (!email || !email.includes('@')) continue;
    entries.push({ email, name: cell(c,nameCol), login: cell(c,loginCol), location: cell(c,locCol) });
  }

  if (!entries.length) { csvMsg.textContent='No valid emails found'; importBtn.disabled=false; return; }
  csvMsg.textContent = 'Importing ' + entries.length + ' entries…';

  const res  = await fetch('/import', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ entries })
  });
  const data = await res.json();
  csvMsg.style.color = data.added > 0 ? '#22c55e' : '#aaa';
  csvMsg.textContent = '✓ Added ' + data.added + ' new · skipped ' + data.skipped + ' duplicates';
  importBtn.disabled = false;
  setTimeout(() => location.reload(), 1500);
});
</script>
</body>
</html>`;
}

function startDashboard(port = 3000) {
  const server = http.createServer((req, res) => {

    // ── GET /api/stats ─────────────────────────────────────────────────────
    if (req.method === 'GET' && req.url === '/api/stats') {
      syncState();
      const r2 = db.exec(
        `SELECT COUNT(*) FROM emails WHERE email NOT LIKE '_no_email_%' AND email NOT IN (SELECT email FROM sent)`
      );
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({
        collected:       emails.filter(e => !e.email.startsWith('_no_email_')).length,
        sent:            dbSentCount(),
        daily:           dbSentToday(),
        unsent:          r2.length ? r2[0].values[0][0] : 0,
        lastId:          state.lastId,
        collecting:      collecting,
        campaignRunning: campaignRunning,
        logs:            logBuffer.slice(0, 30)
      }));
      return;
    }

    // ── GET /export.csv ────────────────────────────────────────────────────
    if (req.method === 'GET' && req.url === '/export.csv') {
      const allRows = dbAllEmails().filter(e => !e.email.startsWith('_no_email_'));
      const COLS = ['email','name','login','location','country','company','followers','repos','hireable','profile','seen_at'];
      const csv  = [COLS.join(','),
        ...allRows.map(e => COLS.map(k => '"' + String(e[k]??'').replace(/"/g,'""') + '"').join(','))
      ].join('\n');
      res.writeHead(200, {
        'Content-Type': 'text/csv',
        'Content-Disposition': 'attachment; filename="realman-emails-' + new Date().toISOString().slice(0,10) + '.csv"'
      });
      res.end(csv);
      return;
    }

    // ── POST /import ───────────────────────────────────────────────────────
    if (req.method === 'POST' && req.url === '/import') {
      let body = '';
      req.on('data', d => body += d);
      req.on('end', () => {
        try {
          const { entries = [] } = JSON.parse(body);
          let added = 0, skipped = 0;
          for (const e of entries) {
            const key = (e.email || '').toLowerCase().trim();
            if (!key || !key.includes('@')) { skipped++; continue; }
            if (dbEmailExists(key)) { skipped++; continue; }
            dbInsertEmail({
              email: key, login: e.login || '', name: e.name || '',
              location: e.location || '', country: extractCountry(e.location || ''),
              company: '', bio: '', blog: '', twitter: '',
              followers: 0, repos: 0, hireable: false, avatar: '', profile: '',
              seen_at: new Date().toISOString()
            });
            added++;
          }
          syncState();
          log('CSV import: +' + added + ' added, ' + skipped + ' skipped — total: ' + emails.length);
          res.writeHead(200, { 'Content-Type': 'application/json' });
          res.end(JSON.stringify({ added, skipped, total: emails.length }));
        } catch(e) {
          res.writeHead(400, { 'Content-Type': 'application/json' });
          res.end(JSON.stringify({ error: e.message }));
        }
      });
      return;
    }

    // ── POST /ctrl/* ───────────────────────────────────────────────────────
    if (req.method === 'POST' && req.url.startsWith('/ctrl/')) {
      const action = req.url.slice(6);
      let ok = true, msg = '';
      if (action === 'collect-start') {
        if (collecting) {
          msg = 'Collector already running.';
        } else {
          if (!GH_TOKEN) { ok=false; msg='GH_TOKEN not set in .env'; }
          else { collectLoop().catch(e => log('Collector error:', e.message)); msg = 'Collector started — scanning GitHub (US only)…'; }
        }
      } else if (action === 'campaign-start') {
        startCampaign();
        msg = campaignRunning ? 'Campaign started — 1 email every 6 min.' : 'Campaign already running.';
      } else if (action === 'stop-all') {
        collecting = false;
        stopCampaign();
        msg = 'Collector and campaign stopped.';
      } else {
        ok = false; msg = 'Unknown action: ' + action;
      }
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ ok, msg }));
      return;
    }

    // ── GET / (dashboard) ──────────────────────────────────────────────────
    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
    res.end(dashboardHTML());
  });
  server.on('error', e => {
    if (e.code === 'EADDRINUSE') {
      log(`Port ${port} in use — trying ${port + 1}`);
      startDashboard(port + 1);
    } else {
      log('Dashboard error:', e.message);
    }
  });
  server.listen(port, () => {
    log(`Dashboard → http://localhost:${port}`);
  });
}

// ── Startup validation ─────────────────────────────────────────────────────
function validate() {
  const missing = [];
  if (!GH_TOKEN)       missing.push('GH_TOKEN');
  if (!GMAIL_USER)     missing.push('GMAIL_USER');
  if (!GMAIL_APP_PASS) missing.push('GMAIL_APP_PASSWORD');
  if (missing.length) {
    console.error('ERROR: Missing .env variables:', missing.join(', '));
    console.error('Copy .env.example to .env and fill in the values.');
    process.exit(1);
  }
}

// ── Campaign scheduler ─────────────────────────────────────────────────────
let campaignRunning = false;
let campaignTimer   = null;

function startCampaign() {
  if (campaignRunning) { log('Campaign already running.'); return; }
  campaignRunning = true;
  log('Campaign STARTED — 1 email every 6 min');
  campaignTick();
  nextSendAt = Date.now() + SEND_INTERVAL_MS;
  campaignTimer = setInterval(async () => {
    await campaignTick();
    nextSendAt = Date.now() + SEND_INTERVAL_MS;
  }, SEND_INTERVAL_MS);
}

function stopCampaign() {
  if (!campaignRunning) { log('Campaign is not running.'); return; }
  campaignRunning = false;
  clearInterval(campaignTimer);
  campaignTimer = null;
  nextSendAt    = null;
  log('Campaign STOPPED.');
}

// ── CLI keyboard commands ──────────────────────────────────────────────────
function startCLI() {
  const readline = require('readline');
  const rl = readline.createInterface({ input: process.stdin });
  console.log('Commands: start | stop | status | quit');
  rl.on('line', line => {
    const cmd = line.trim().toLowerCase();
    if (cmd === 'start')  startCampaign();
    else if (cmd === 'stop')   stopCampaign();
    else if (cmd === 'status') {
      syncState();
      log('Collected: ' + emails.filter(e => !e.email.startsWith('_no_email_')).length + ' | Sent: ' + dbSentCount() + ' | Today: ' + dbSentToday() + ' | Campaign: ' + (campaignRunning?'running':'stopped'));
    }
    else if (cmd === 'quit' || cmd === 'exit') process.exit(0);
    else console.log('Unknown command. Try: start | stop | status | quit');
  });
}

// ── Main ───────────────────────────────────────────────────────────────────
async function main() {
  validate();
  const SQL = await initSqlJs();
  dbInit(SQL);
  syncState();
  log('Realman server starting…');
  log('DB: ' + emails.filter(e => !e.email.startsWith('_no_email_')).length + ' US emails | ' + dbSentCount() + ' sent');
  log('Campaign: 1 email every 6 min · 10/hr · 240/day');

  startDashboard(3000);

  // Verify Gmail credentials (warning only — don't crash)
  try {
    await transporter.verify();
    log('Gmail auth OK —', GMAIL_USER);
  } catch(e) {
    log('⚠ Gmail auth failed:', e.message);
    log('  SMTP may be blocked locally — will work on VPS.');
  }

  log('Ready. Use the dashboard buttons or type: start | stop | status | quit');

  // Start CLI
  startCLI();
}

main().catch(e => { console.error('Fatal:', e); process.exit(1); });
