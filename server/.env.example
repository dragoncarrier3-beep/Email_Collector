# GitHub personal access token (needs no special scopes — public data only)
# Create at: https://github.com/settings/tokens → Generate new token (classic)
GH_TOKEN=ghp_your_token_here

# Gmail account that SENDS the emails
GMAIL_USER=yourname@gmail.com

# Gmail App Password (NOT your regular password)
# How to get one:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to: myaccount.google.com → Security → App passwords
#   3. Select "Mail" + "Other (Custom name)" → Generate
#   4. Paste the 16-character password below (no spaces)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxxxxxx
